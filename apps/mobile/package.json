{
  "name": "lunarr-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "gen:api": "openapi-ts",
    "gen:openapi": "cd ../../../lunarr-go && bun -e \"import { openApiDocument } from './src/lib/server/openapi.ts'; await Bun.write('../lunarr-client/apps/mobile/openapi.json', JSON.stringify(openApiDocument, null, 2));\" && cd ../../../lunarr-client/apps/mobile && bun run gen:api",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "@react-native-community/slider": "5.2.0",
    "@tanstack/react-query": "5.101.4",
    "expo": "~57.0.9",
    "expo-build-properties": "~57.0.8",
    "expo-constants": "~57.0.8",
    "expo-dev-client": "~57.0.10",
    "expo-font": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-screen-orientation": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.2",
    "lucide-react-native": "1.28.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@types/react": "~19.2.2",
    "prettier": "3.9.6",
    "typescript": "~6.0.3"
  }
}
