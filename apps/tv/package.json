{
  "name": "lunarr-tv",
  "main": "expo-router/entry",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "EXPO_TV=1 expo prebuild -p ios",
    "prebuild:clean": "EXPO_TV=1 expo prebuild --clean -p ios",
    "prebuild:android": "EXPO_TV=1 expo prebuild -p android",
    "prebuild:android:clean": "EXPO_TV=1 expo prebuild --clean -p android",
    "gen:api": "pnpm --filter @lunarr/api gen:api",
    "gen:openapi": "pnpm --filter @lunarr/api gen:openapi",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "@lunarr/api": "workspace:*",
    "@lunarr/core": "workspace:*",
    "@lunarr/mpv-player": "1.1.1",
    "@tanstack/react-query": "5.101.4",
    "expo": "~57.0.13",
    "expo-build-properties": "~57.0.11",
    "expo-constants": "~57.0.11",
    "expo-dev-client": "~57.0.12",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-router": "~57.0.13",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "1.28.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "npm:react-native-tvos@0.86.0-2",
    "react-native-linear-gradient": "2.8.3",
    "react-native-qr-svg": "1.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@react-native-tvos/config-tv": "0.1.6",
    "@types/react": "~19.2.18",
    "prettier": "3.9.6",
    "typescript": "~6.0.3"
  }
}
